# Documentation only: export settings in your shell/host. Not automatically loaded.
APP_ENV=development
APP_TIMEZONE=America/Chicago
# SECRET_KEY=<generate a stable random value; required in production>
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require
# Local default: database/olumira.db (absolute path resolved by the application).
# TEST_POSTGRES_URL=<new empty disposable PostgreSQL database for integration tests>
