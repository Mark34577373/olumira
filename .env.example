# Documentation only: export settings in your shell/host. Not automatically loaded.
APP_ENV=development
APP_TIMEZONE=America/Chicago
# SECRET_KEY=<generate a stable random value; required in production>
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=verify-full
# Local default: database/olumira.db (absolute path resolved by the application).
# TEST_POSTGRES_URL=<new empty disposable PostgreSQL database for integration tests>

# Day 15: required shared limiter in production (credentials belong only in environment).
# RATELIMIT_STORAGE_URI=rediss://<user>:<password>@<host>:<port>/0
AUTH_SESSION_SECONDS=43200
AUTH_IDLE_SECONDS=1800
# Existing signup behavior is preserved; set false to close GET and POST registration.
# This does not create an invitation-only signup system or a beta request inbox.
REGISTRATION_ENABLED=true
TRUSTED_PROXY_HOPS=0
# TRUSTED_HOSTS=<your-app-hostname>,<your-custom-hostname>
# Configure proxy hops only for your reviewed trusted reverse-proxy topology.

# Day 16: local preview backend by default; no real email is sent in this mode.
PUBLIC_APP_URL=http://127.0.0.1:5000
MAIL_BACKEND=development
# Production: PUBLIC_APP_URL must use HTTPS; MAIL_BACKEND must be smtp.
# MAIL_FROM=Olumira <no-reply@your-verified-domain>
# MAIL_ENCRYPTION_KEY=<independent Fernet key; back up separately from the database>
# SMTP_HOST=<transactional SMTP hostname>
SMTP_PORT=587
SMTP_SECURITY=starttls
# SMTP_USERNAME=<provider SMTP username>
# SMTP_PASSWORD=<provider SMTP password>
VERIFY_TOKEN_SECONDS=3600
RESET_TOKEN_SECONDS=1800
EMAIL_CHANGE_TOKEN_SECONDS=1800
# Run mail-send-pending on a scheduled worker for SMTP delivery.

# Family invitations (60–86400 seconds); delivered by the existing outbox worker.
INVITATION_SECONDS=86400
# PUBLIC_APP_URL must match the actual local port (5000 if using python app.py).

# Days 41–42: test URLs must identify NEW EMPTY disposable databases only.
# TEST_POSTGRES_SECURITY_URL=<second disposable PostgreSQL DB for tenant/concurrency tests>
# Testing defaults to private in-memory SQLite; production DATABASE_URL is ignored.
# Production defaults TRUSTED_HOSTS to the PUBLIC_APP_URL hostname if not supplied.
# Apply gunicorn.conf.py and independently redact reverse-proxy/provider logs.
# Explicit operator workflows: mail-retention [--apply], security-revoke-access --confirm ...
